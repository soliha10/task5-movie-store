<div class="movie-details row g-4">
  <div class="col-md-5 col-xl-4">
    <%= render "movies/trailer", movie: movie %>
    <div class="mt-2">
      <span class="badge rounded-pill text-bg-primary likes-badge" title="<%= region_label(:likes) %>">
        <%= movie.likes %> <i class="bi bi-hand-thumbs-up-fill"></i>
      </span>
    </div>
  </div>
  <div class="col">
    <h4 class="mb-1">
      <%= movie.title %>
      <small class="text-body-secondary fw-normal fs-6"><%= movie.year %>, <%= movie.genre_name %></small>
    </h4>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2 small">
      <% movie.badges.each do |badge| %>
        <span class="badge text-bg-secondary"><%= region_label(:badges, badge) %></span>
      <% end %>
      <span class="text-body-secondary"><%= runtime_summary(movie) %></span>
      <span class="fw-bold fst-italic"><%= movie.age_rating %></span>
    </div>
    <p class="small mb-1"><span class="text-body-secondary"><%= region_label(:cast) %>:</span> <em><%= cast_names(movie) %></em></p>
    <p class="small mb-2"><span class="text-body-secondary"><%= region_label(:director) %>:</span> <em><%= movie.director %></em></p>
    <p class="small mb-3"><%= movie.plot %></p>

    <h6 class="text-body-secondary small text-uppercase mb-2"><%= region_label(:reviews) %> (<%= movie.reviews.size %>)</h6>
    <%= render(partial: "movies/review", collection: movie.reviews) || tag.p(region_label(:no_reviews), class: "small text-body-secondary") %>
  </div>
</div>
