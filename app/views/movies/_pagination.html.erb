<nav aria-label="Pages">
  <ul class="pagination pagination-sm mb-0">
    <%= page_item GenerationState::FIRST_PAGE, text: "«", title: "First page", disabled: state.first_page? %>
    <%= page_item [state.page - 1, GenerationState::FIRST_PAGE].max, text: "‹", title: "Previous", disabled: state.first_page? %>
    <% nearby_page_numbers.each do |page_number| %>
      <%= page_item page_number %>
    <% end %>
    <%= page_item state.page + 1, text: "›", title: "Next" %>
  </ul>
</nav>
