<div data-controller="table">
  <div class="table-responsive">
    <table class="table movie-table align-middle mb-3">
      <thead>
        <tr>
          <th class="chev-col"></th>
          <th class="idx-col">#</th>
          <th class="genre-col"><%= region_label(:genre) %></th>
          <th><%= region_label(:title) %></th>
          <th><%= region_label(:cast) %></th>
          <th class="text-end year-col"><%= region_label(:year) %></th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "movies/table_row", collection: movies, as: :movie %>
      </tbody>
    </table>
  </div>

  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
    <%= render "movies/pagination" %>
    <%= link_to export_path(state.query(page: state.page)), class: "btn btn-sm btn-outline-secondary", data: { turbo: false },
          title: "Download the trailers of this page as a ZIP of MP4 files" do %>
      <i class="bi bi-file-earmark-zip"></i> Export page <%= state.page %> (ZIP)
    <% end %>
  </div>
</div>
