<%= form_with url: root_path, method: :get, id: "toolbar", class: "toolbar sticky-top border-bottom",
      data: { controller: "toolbar", turbo_frame: "results", turbo_action: "advance",
              action: "submit->toolbar#scrollToTop turbo:before-frame-render@document->toolbar#resultsWillRender" } do %>
  <div class="container-xxl px-3 py-2 d-flex flex-wrap flex-lg-nowrap align-items-end gap-2 gap-lg-3">
    <div class="brand d-none d-xl-flex align-items-center me-1">
      <i class="bi bi-film"></i><span>ReelForge</span>
    </div>

    <div class="tool-field">
      <label for="locale" class="form-label">Language</label>
      <%= select_tag :locale, options_for_select(Region.all.map { |region| [region.name, region.code] }, state.region.code),
            class: "form-select form-select-sm", data: { action: "toolbar#submit" } %>
    </div>

    <div class="tool-field seed-field">
      <label for="seed" class="form-label">Seed</label>
      <div class="input-group input-group-sm">
        <%= text_field_tag :seed, state.seed, inputmode: "numeric", autocomplete: "off", spellcheck: false,
              class: "form-control font-monospace", data: { toolbar_target: "seed", action: "toolbar#submitLater" } %>
        <button type="button" class="btn btn-outline-secondary" title="Random seed" data-action="toolbar#randomSeed">
          <i class="bi bi-shuffle"></i>
        </button>
      </div>
    </div>

    <div class="tool-field likes-field">
      <label for="likes" class="form-label d-flex justify-content-between">
        <span>Likes</span><output class="fw-semibold" data-toolbar-target="likesOutput"><%= state.likes %></output>
      </label>
      <%= range_field_tag :likes, state.likes, in: GenerationState::AVERAGE_RANGE, step: 0.1,
            class: "form-range", data: { toolbar_target: "likes", action: "toolbar#likesMoved" } %>
    </div>

    <div class="tool-field reviews-field">
      <label for="reviews" class="form-label">Reviews</label>
      <%= number_field_tag :reviews, state.reviews, in: GenerationState::AVERAGE_RANGE, step: 0.1,
            class: "form-control form-control-sm", data: { action: "toolbar#submitLater" } %>
    </div>

    <div class="ms-auto btn-group btn-group-sm" role="group" aria-label="View">
      <% GenerationState::VIEWS.each do |view| %>
        <%= view_toggle(view) %>
      <% end %>
    </div>
  </div>
<% end %>
